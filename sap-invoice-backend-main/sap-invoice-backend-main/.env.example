# ══════════════════════════════════════════════════
# Cooper SAP Invoice Backend — Environment Variables
# ══════════════════════════════════════════════════
# Copy this file to .env and fill in Cooper's actual values:
#   cp .env.example .env

# ── Django ──
SECRET_KEY=your-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (Cooper's existing PostgreSQL) ──
DB_NAME=cooper_db
DB_USER=cooper_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── JWT Token Lifetimes ──
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=7
